PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/agritrade

# Authentication & JWT
JWT_SECRET=your_super_secret_jwt_access_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# OTP Configuration
OTP_MODE=development
DEV_OTP=123456
OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=60

# AI Intelligence (Google Gemini 1.5 Flash)
# If empty or invalid, the platform gracefully uses deterministic domain heuristics
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Travel & Maps Integration
MAP_PROVIDER=mock
GOOGLE_MAPS_API_KEY=

# System Defaults & Rate Limiting
DEFAULT_LANGUAGE=en
QUEUE_SAFETY_BUFFER_MINUTES=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Super Admin Initial Credentials (Seeding)
SUPER_ADMIN_NAME=Platform Administrator
SUPER_ADMIN_EMAIL=admin@agritrade.gov.in
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=Admin@123456
